{
  "name": "draw",
  "version": "0.0.0",
  "private": true,
  "description": "Draw: an independent desktop vector graphics editor (monorepo)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run boundaries && npm test",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "node tools/check-boundaries.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "fixtures": "node tools/fetch-fixtures.ts",
    "cdr2svg": "node tools/cdr2svg.ts",
    "viewer": "vite tools/viewer"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
